{
  "manifest_version": 3,
  "name": "Surface Hound",
  "version": "0.12.1",
  "description": "Reconocimiento pasivo en vivo y puente a herramientas locales para bug bounty.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "downloads",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "network-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "devtools_page": "devtools.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Surface Hound"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Zuk4r1 (Yordan Su\u00e1rez)"
}